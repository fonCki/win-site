# API Configuration
# Copy this file to .env and fill in the actual values

# Base URL for all API endpoints (chat, log, guestbook, cv)
VITE_API_BASE_URL=https://your-api-gateway-url.amazonaws.com

# IP lookup service (public API, can keep default)
VITE_IP_API_URL=https://api.ipify.org?format=json

# Analytics runs in production by default and is disabled for local development.
# Set false to disable it in a production preview; true to enable it locally.
# VITE_ANALYTICS_ENABLED=false
